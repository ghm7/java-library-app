{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Format Java (Google Java Format)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\format.ps1"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Check Java formatting (Google Java Format)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\format.ps1",
        "-Check"
      ],
      "problemMatcher": []
    }
  ]
}
